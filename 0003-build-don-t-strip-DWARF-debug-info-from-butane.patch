From 21cc98857057175d3d17a6e4b1f39855c9d8b317 Mon Sep 17 00:00:00 2001
From: Steven Presti <spresti@redhat.com>
Date: Fri, 9 Oct 2026 12:52:01 -0400
Subject: [PATCH] build: don't strip DWARF debug info from butane

The butane and cross-butane builds passed '-w' to the Go linker, which
omits the DWARF debug info from the resulting binaries. This diverges
from the ignition and ignition-validate builds, which keep debug info,
and leaves downstream debuginfo packages without usable debug symbols.

Drop '-w' so butane produces debuggable binaries consistent with the
other build targets. Distro packaging still splits debug symbols into a
separate debuginfo package, so the shipped binary remains stripped.

Signed-off-by: Steven Presti <spresti@redhat.com>
---
 build | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/build b/build
index 4c96bd99..20e08739 100755
--- a/build
+++ b/build
@@ -67,7 +67,7 @@ ignition_validate_cross() {
 
 butane() {
 	local name="butane"
-	local butane_ldflags="-w -X github.com/coreos/ignition/v2/butane/internal/version.Raw=${VERSION}"
+	local butane_ldflags="-X github.com/coreos/ignition/v2/butane/internal/version.Raw=${VERSION}"
 
 	echo "Building ${name}..."
 	CGO_ENABLED=0 go build -ldflags "${butane_ldflags}" -o "${BIN_PATH}/${name}" ${REPO_PATH}/butane/internal
@@ -75,7 +75,7 @@ butane() {
 
 build_cross_butane() {
 	local goos=$1 goarch=$2 output=$3
-	local butane_ldflags="-w -X github.com/coreos/ignition/v2/butane/internal/version.Raw=${VERSION}"
+	local butane_ldflags="-X github.com/coreos/ignition/v2/butane/internal/version.Raw=${VERSION}"
 	echo "Building ${output}..."
 	CGO_ENABLED=0 GOARCH=${goarch} GOOS=${goos} go build -ldflags "${butane_ldflags}" -a -v -x -o "${BIN_PATH}/${output}" ${REPO_PATH}/butane/internal
 }
