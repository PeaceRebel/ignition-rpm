From cfd44157c9d29f3afd3b888d129244a9b1187f06 Mon Sep 17 00:00:00 2001
From: Bipin B Narayan <bbnaraya@redhat.com>
Date: Tue, 29 Sep 2026 14:32:21 +0530
Subject: [PATCH 1/2] build: Rename butane binary to avoid conflict with butane
 dir

---
 Makefile | 2 +-
 build    | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/Makefile b/Makefile
index 1cd905a0..0dd9402a 100644
--- a/Makefile
+++ b/Makefile
@@ -71,7 +71,7 @@ install-ignition-validate-cross:
 
 .PHONY: install-butane
 install-butane:
-	install -m 0755 -D -t $(DESTDIR)/usr/bin $(BIN_PATH)/butane
+	install -m 0755 $(BIN_PATH)/butane-bin $(DESTDIR)/usr/bin/butane
 
 # For distros that need to build cross platform butane binaries
 .PHONY: install-butane-cross
diff --git a/build b/build
index 4c96bd99..3a74db2d 100755
--- a/build
+++ b/build
@@ -66,7 +66,7 @@ ignition_validate_cross() {
 }
 
 butane() {
-	local name="butane"
+	local name="butane-bin" # to avoid conflict with the butane dir
 	local butane_ldflags="-w -X github.com/coreos/ignition/v2/butane/internal/version.Raw=${VERSION}"
 
 	echo "Building ${name}..."
-- 
2.55.0


From 9279c0c0094d53da34c6fc76c0de2d01f6596bf6 Mon Sep 17 00:00:00 2001
From: Bipin B Narayan <bbnaraya@redhat.com>
Date: Tue, 29 Sep 2026 15:20:00 +0530
Subject: [PATCH 2/2] Makefile: install /usr/bin/fcct as symlink to butane

---
 Makefile | 1 +
 1 file changed, 1 insertion(+)

diff --git a/Makefile b/Makefile
index 0dd9402a..b4bb434b 100644
--- a/Makefile
+++ b/Makefile
@@ -72,6 +72,7 @@ install-ignition-validate-cross:
 .PHONY: install-butane
 install-butane:
 	install -m 0755 $(BIN_PATH)/butane-bin $(DESTDIR)/usr/bin/butane
+	ln -s butane $(DESTDIR)/usr/bin/fcct
 
 # For distros that need to build cross platform butane binaries
 .PHONY: install-butane-cross
-- 
2.55.0

